generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id         String    @id @default(cuid())
  username   String    @unique
  name       String
  email      String? // برای بازیابی رمز عبور
  salt       String
  hash       String
  role       String    @default("student") // "student" | "admin" | "parent" | "superadmin" | "educational_rep"
  /** حساب غیرفعال نمی‌تواند وارد شود (برای نماینده‌ها از پنل مدیر سایت) */
  active     Boolean   @default(true)
  /** کلاس دانش‌آموز یا کلاس مسئولیت نماینده (خالی = بدون کلاس) */
  classId    String?
  clazz      SchoolClass? @relation("ClassStudents", fields: [classId], references: [id], onDelete: SetNull)
  /** راهنمای سه‌مرحله‌ای دانش‌آموز دیده شده؟ (در دیتابیس ذخیره می‌شود) */
  guideSeen  Boolean   @default(false)
  /** دادهٔ تست — با npm run seed:test:remove پاک می‌شود */
  isTest     Boolean   @default(false)
  /** نام کاربری والد این دانش‌آموز — اتصال والد به فرزند (خالی = بدون والد) */
  parentUsername String @default("")
  avatar     String    @default("") // نام فایل عکس پروفایل در db/uploads/avatars
  avatarType String    @default("") // mime عکس پروفایل
  createdAt  DateTime  @default(now())
  sessions   Session[]
  progress   Progress?
}

model PasswordReset {
  username  String   @id
  codeHash  String // sha256(code)
  expiresAt DateTime
}

/** کلاس مدرسه — هر دانش‌آموز در یک کلاس و هر کلاس یک نمایندهٔ آموزشی */
model SchoolClass {
  id          String       @id @default(cuid())
  name        String       @unique
  year        String       @default("")
  active      Boolean      @default(true)
  /** نام کاربری نمایندهٔ مسئول این کلاس (خالی = بدون نماینده) */
  repUsername String       @default("")
  createdAt   DateTime     @default(now())
  isTest      Boolean      @default(false)
  students    User[]       @relation("ClassStudents")
  assignments Assignment[]
}

model Progress {
  username      String   @id
  user          User     @relation(fields: [username], references: [username], onDelete: Cascade)
  field         String   @default("")
  level         String   @default("")
  completedJson String   @default("{}")
  badgesJson    String   @default("[]")
  updatedAt     DateTime @updatedAt
}

model Session {
  id        String   @id
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}

/**
 * ارسال هر ماموریت روزانه توسط دانش‌آموز — همراه با وضعیت بررسی معلم.
 * کلید یکتا: هر دانش‌آموز برای هر ماموریت (رشته_سطح_روز_شماره) یک ارسال دارد
 * که در صورت «نیاز به اصلاح» دوباره به‌روزرسانی می‌شود.
 */
model MissionSubmission {
  id          String    @id @default(cuid())
  username    String
  missionKey  String
  field       String    @default("")
  level       String    @default("")
  day         String    @default("")
  idx         Int       @default(0)
  kind        String    @default("practical") // practical | reading
  title       String    @default("")
  text        String    @default("")
  link        String    @default("")
  fileId      String    @default("")
  fileName    String    @default("")
  fileType    String    @default("")
  status      String    @default("pending") // pending | approved | revision
  teacherNote String    @default("")
  isTest      Boolean   @default(false)
  reviewedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([username, missionKey])
  @@index([username, status])
  @@index([status, updatedAt])
}

/** آلبوم گالری مدرسه — کاور و عکس‌ها در public/uploads/gallery ذخیره می‌شوند */
model GalleryAlbum {
  id          String         @id @default(cuid())
  title       String
  description String         @default("")
  cover       String         @default("") // نام فایل تصادفی کاور
  sort        Int            @default(0)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  photos      GalleryPhoto[]
}

model GalleryPhoto {
  id        String       @id @default(cuid())
  albumId   String
  album     GalleryAlbum @relation(fields: [albumId], references: [id], onDelete: Cascade)
  file      String // نام فایل تصادفی در public/uploads/gallery
  caption   String       @default("")
  sort      Int          @default(0)
  createdAt DateTime     @default(now())

  @@index([albumId, sort])
}

/** اطلاعیهٔ مدرسه/معلم — خوانده‌شدن هر والد در AnnouncementRead ثبت می‌شود */
model Announcement {
  id        String   @id @default(cuid())
  title     String
  body      String
  important Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AnnouncementRead {
  username       String
  announcementId String
  readAt         DateTime @default(now())

  @@id([username, announcementId])
}

/** رویداد تقویم مدرسه (جلسهٔ اولیا، امتحان، اردو، تعطیلی) */
model SchoolEvent {
  id          String   @id @default(cuid())
  title       String
  description String   @default("")
  kind        String   @default("event") // meeting | exam | trip | holiday | event
  startsAt    DateTime
  createdAt   DateTime @default(now())

  @@index([startsAt])
}

/** پیام والد به معلم — با پاسخ معلم (status: sent | answered) */
model ParentMessage {
  id             String    @id @default(cuid())
  parentUsername String
  studentUsername String   @default("")
  subject        String
  body           String
  reply          String    @default("")
  status         String    @default("sent") // sent | answered
  createdAt      DateTime  @default(now())
  repliedAt      DateTime?

  @@index([parentUsername, createdAt])
}

model Video {
  id        String   @id
  title     String
  fileId    String
  filename  String
  type      String   @default("video/mp4")
  createdAt DateTime @default(now())
}

model Assignment {
  id          String       @id
  title       String
  body        String
  deadline    DateTime
  /** کلاس یا رشته/سطح مربوط — متن آزاد، خالی یعنی برای همه */
  audience    String       @default("")
  /** کلاس مربوط — خالی یعنی همهٔ کلاس‌ها (تکالیف قدیمی) */
  classId     String?
  class       SchoolClass? @relation(fields: [classId], references: [id], onDelete: SetNull)
  isTest      Boolean      @default(false)
  createdAt   DateTime     @default(now())
  submissions Submission[]
}

model Submission {
  id           String     @id
  assignmentId String
  assignment   Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  user         String
  fileId       String
  fileName     String
  extraId      String     @default("")
  extraName    String     @default("")
  note         String     @default("")
  /** pending | approved | revision */
  status       String     @default("pending")
  /** بازخورد یا دلیل برگشت برای اصلاح */
  feedback     String     @default("")
  /** نمرهٔ اختیاری (متن آزاد مثل «۱۸» یا «۱۸ از ۲۰») */
  grade        String     @default("")
  reviewedAt   DateTime?
  isTest       Boolean    @default(false)
  at           DateTime   @default(now())
}

/** کار تاییدشدهٔ انتخاب‌شده برای نمایشگاه — بدون کپی فایل، فقط ارجاع */
model ShowcaseItem {
  id          String   @id @default(cuid())
  username    String
  /** mission = ارسال ماموریت، task = ارسال تکلیف */
  sourceType  String
  sourceId    String
  title       String   @default("")
  description String   @default("")
  pinned      Boolean  @default(false)
  hidden      Boolean  @default(false)
  isTest      Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([username, sourceType, sourceId])
  @@index([username])
}

/** گزارش هفتگی اولیا — محاسبه‌شده از داده، ذخیره‌شده برای تاریخچه و «گزارش جدید» */
model WeeklyReport {
  id         String    @id @default(cuid())
  username   String
  /** کلید روز شنبهٔ همان هفته (YYYY-MM-DD میلادی، مطابق dayKey) */
  weekStart  String
  dataJson   String    @default("{}")
  summary    String    @default("")
  /** وقتی والد گزارش را دید پر می‌شود — نشان «گزارش جدید» */
  seenAt     DateTime?
  isTest     Boolean   @default(false)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@unique([username, weekStart])
  @@index([username])
}
