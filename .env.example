# دیتابیس SQLite (مسیر نسبت به پوشهٔ prisma)
DATABASE_URL=file:../db/custom.db

# اختیاری — اگر تنظیم شود، آزمون تعیین سطح از OpenRouter استفاده می‌کند
# در غیر این صورت به‌صورت خودکار از API رایگان Pollinations (بدون کلید) استفاده می‌شود
# و اگر آن هم در دسترس نبود به سرویس داخلی fallback می‌شود
# OPENROUTER_API_KEY=sk-or-v1-...
# OPENROUTER_MODEL=openai/gpt-4o-mini
# OPENROUTER_SITE_URL=https://your-site.example

# اختیاری — مدل سرویس رایگان Pollinations (پیش‌فرض: openai-fast)
# POLLINATIONS_MODEL=openai-fast

# ارسال ایمیل بازیابی رمز عبور (اختیاری)
# اگر تنظیم نشود، کد بازیابی در حالت آزمایشی در خود صفحه نشان داده می‌شود
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=my.email@gmail.com
# SMTP_PASS=xxxx xxxx xxxx xxxx
# SMTP_FROM="مسیر رشد <my.email@gmail.com>"

# مرورگر ابری Browserless (اختیاری) — توکن از https://browserless.io/account/
# اسکریپت «npm run browserless:check» همین مقدار را می‌خواند؛ توکن واقعی را هرگز کامیت نکن
BROWSERLESS_TOKEN=
# BROWSERLESS_ENDPOINT=wss://production-sfo.browserless.io